{
  "name": "grovekit",
  "version": "0.4.0",
  "description": "A grove of git worktrees: every branch gets its own running stack, on its own ports.",
  "type": "module",
  "bin": {
    "grove": "./dist/cli.js",
    "git-grove": "./dist/cli.js",
    "ewt": "./dist/cli.js",
    "wt": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jovalle02/grovekit.git"
  },
  "bugs": {
    "url": "https://github.com/jovalle02/grovekit/issues"
  },
  "homepage": "https://github.com/jovalle02/grovekit#readme",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/index.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "git-worktree",
    "worktree",
    "docker-compose",
    "traefik",
    "dev-environment",
    "ports",
    "e2e",
    "developer-tools"
  ],
  "license": "MIT"
}
