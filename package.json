{
  "name": "easy-worktree",
  "version": "0.2.0",
  "description": "Every git worktree gets its own fully-deployed, independently addressable stack.",
  "type": "module",
  "bin": {
    "wt": "./dist/cli.js",
    "ewt": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jovalle02/easy-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/jovalle02/easy-worktree/issues"
  },
  "homepage": "https://github.com/jovalle02/easy-worktree#readme",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/index.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "git-worktree",
    "docker-compose",
    "traefik",
    "e2e",
    "developer-tools"
  ],
  "license": "MIT"
}
